<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gospel Case Files — Unified Lab Workspace</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #0b0f19;
      color: #f3f4f6;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    .container {
      max-width: 950px;
      width: 100%;
    }

    header {
      margin-bottom: 24px;
      text-align: center;
    }

    h1 {
      font-size: 1.85rem;
      color: #fbbf24;
      margin-bottom: 6px;
    }

    p.subtitle {
      color: #9ca3af;
      font-size: 0.95rem;
    }

    .section-title {
      font-size: 1.1rem;
      color: #38bdf8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .divider {
      border: 0;
      height: 1px;
      background: #1e293b;
      margin: 28px 0;
    }

    /* --- MENU.JS COMPONENT STYLES --- */
    .act-selector-wrapper {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: #0f172a;
      border: 1px solid #1e293b;
      padding: 16px;
      border-radius: 12px;
    }

    .act-tabs {
      display: flex;
      gap: 8px;
      border-bottom: 2px solid #1e293b;
      padding-bottom: 8px;
      overflow-x: auto;
    }

    .act-tab {
      background: #1e293b;
      color: #9ca3af;
      border: 1px solid #334155;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .act-tab:hover {
      background: #334155;
      color: #fff;
    }

    .act-tab.active {
      background: #d97706 !important;
      color: #fff !important;
      border-color: #fbbf24 !important;
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }

    .case-card {
      background: #0b0f19;
      border: 2px solid #1e293b;
      border-radius: 10px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.15s ease-in-out;
    }

    .case-card:not(.locked):hover {
      border-color: #475569;
    }

    .case-card.locked {
      opacity: 0.45;
      filter: grayscale(80%);
    }

    .case-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .act-tag {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .difficulty-stars {
      color: #fbbf24;
      font-size: 0.85rem;
    }

    .case-title {
      font-size: 1rem;
      font-weight: 700;
      color: #f3f4f6;
      margin-bottom: 4px;
    }

    .case-subtitle {
      font-size: 0.78rem;
      color: #9ca3af;
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .case-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px solid #1e293b;
    }

    .location-label {
      font-size: 0.75rem;
      color: #9ca3af;
    }

    .select-case-btn {
      background: #d97706;
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .select-case-btn:hover:not([disabled]) {
      background: #b45309;
    }

    .select-case-btn[disabled] {
      background: #1e293b;
      color: #64748b;
      cursor: not-allowed;
    }

    /* --- LAB WORKSPACE STYLES --- */
    .nav-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      border-bottom: 2px solid #1e293b;
      padding-bottom: 10px;
    }

    .tab-btn {
      background: #1e293b;
      color: #9ca3af;
      border: 1px solid #334155;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .tab-btn:hover {
      background: #334155;
      color: #fff;
    }

    .tab-btn.active {
      background: #d97706;
      color: #fff;
      border-color: #fbbf24;
    }

    .feedback-box {
      min-height: 48px;
      background: #1e293b;
      border-left: 4px solid #3b82f6;
      padding: 12px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
    }

    .feedback-box.success {
      border-left-color: #10b981;
      background: #064e3b;
      color: #ecfdf5;
    }

    .feedback-box.error {
      border-left-color: #ef4444;
      background: #7f1d1d;
      color: #fef2f2;
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }

    .ev-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .ev-card {
      background: #0f172a;
      border: 2px solid #1e293b;
      border-radius: 10px;
      padding: 12px;
      cursor: pointer;
      transition: all .15s ease-in-out;
      min-height: 100px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .ev-card:hover {
      border-color: #475569;
    }

    .ev-card.selected {
      border-color: #fbbf24;
      background: #1c1917;
    }

    .ev-card.used {
      opacity: 0.4;
      pointer-events: none;
      filter: grayscale(80%);
    }

    .ev-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 6px;
      margin-bottom: 8px;
    }

    .ev-card-title-group {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow: hidden;
    }

    .ev-icon {
      font-size: 1.2rem;
    }

    .ev-name {
      font-weight: 700;
      font-size: 0.85rem;
      color: #f3f4f6;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .compare-ab {
      background: #fbbf24;
      color: #000;
      font-weight: 900;
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .ev-info-btn {
      background: #1e293b;
      color: #fbbf24;
      border: 1px solid #374151;
      border-radius: 6px;
      padding: 3px 8px;
      font-size: 0.7rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      transition: background .15s, color .15s;
      flex-shrink: 0;
    }

    .ev-info-btn:hover {
      background: #334155;
      color: #ffffff;
    }

    .ev-desc {
      font-size: 0.78rem;
      color: #9ca3af;
      line-height: 1.3;
    }

    .actions-bar {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 10px;
    }

    .btn-submit {
      background: #d97706;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-submit:hover {
      background: #b45309;
    }

    .link-group-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .link-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 8px;
    }

    .link-select {
      background: #1e293b;
      color: #fff;
      border: 1px solid #475569;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 0.8rem;
    }

    .timeline-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .timeline-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #0f172a;
      border: 1px solid #1e293b;
      padding: 10px 14px;
      border-radius: 8px;
    }

    .timeline-controls {
      display: flex;
      gap: 6px;
    }

    .btn-arrow {
      background: #1e293b;
      color: #fff;
      border: 1px solid #475569;
      border-radius: 4px;
      width: 28px;
      height: 28px;
      cursor: pointer;
      font-weight: bold;
    }

    .btn-arrow:hover {
      background: #334155;
    }

    /* Modal Styling */
    .modal-mask {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }

    .modal-card {
      background: #0f172a;
      border: 2px solid #fbbf24;
      border-radius: 12px;
      width: 90%;
      max-width: 520px;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 8px;
    }

    .modal-title {
      font-size: 1.1rem;
      color: #fbbf24;
      font-weight: 700;
    }

    .modal-close {
      background: transparent;
      border: none;
      color: #9ca3af;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .modal-body {
      font-size: 0.88rem;
      line-height: 1.5;
      color: #d1d5db;
      margin-bottom: 16px;
    }

    .detail-row {
      background: #1e293b;
      padding: 12px;
      border-radius: 6px;
      border-left: 4px solid #38bdf8;
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .detail-row strong {
      color: #38bdf8;
      display: block;
      margin-bottom: 4px;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1 id="active-case-title">Act I: The Missing Donkey</h1>
    <p id="active-case-subtitle" class="subtitle">Select any registered case file below to test its evidence in the lab workspace.</p>
  </header>

  <!-- 1. CASE SELECTION MENU -->
  <section>
    <div class="section-title">📁 Case Registry Navigation</div>
    <div id="menu-container"></div>
  </section>

  <hr class="divider">

  <!-- 2. LAB ACTION WORKSPACE -->
  <section>
    <div class="section-title">🔬 Active Investigation Workspace</div>

    <!-- Navigation Tabs -->
    <div class="nav-tabs">
      <button class="tab-btn active" onclick="switchTab('compare')">Compare</button>
      <button class="tab-btn" onclick="switchTab('link')">Link</button>
      <button class="tab-btn" onclick="switchTab('timeline')">Timeline</button>
      <button class="tab-btn" onclick="switchTab('contradict')">Contradict</button>
    </div>

    <!-- Feedback Banner -->
    <div id="feedback" class="feedback-box">
      Select an action mode above to begin analyzing the active case evidence.
    </div>

    <!-- TAB 1: COMPARE -->
    <div id="panel-compare" class="tab-panel active">
      <div id="compare-bank" class="ev-grid"></div>
      <div class="actions-bar">
        <button class="btn-submit" onclick="submitCompare()">Compare Selected Pair</button>
      </div>
    </div>

    <!-- TAB 2: LINK -->
    <div id="panel-link" class="tab-panel">
      <div id="link-container" class="link-group-container"></div>
      <div class="actions-bar">
        <button class="btn-submit" onclick="submitLink()">Submit Group Links</button>
      </div>
    </div>

    <!-- TAB 3: TIMELINE -->
    <div id="panel-timeline" class="tab-panel">
      <div id="timeline-list" class="timeline-list"></div>
      <div class="actions-bar">
        <button class="btn-submit" onclick="submitTimeline()">Verify Order</button>
      </div>
    </div>

    <!-- TAB 4: CONTRADICT -->
    <div id="panel-contradict" class="tab-panel">
      <div id="contradict-bank" class="ev-grid"></div>
      <div class="actions-bar">
        <button class="btn-submit" onclick="submitContradict()">Flag Selected Fakes</button>
      </div>
    </div>
  </section>
</div>

<!-- Contextual Evidence Detail Modal -->
<div id="modal-mask" class="modal-mask" onclick="closeModal()">
  <div class="modal-card" onclick="event.stopPropagation()">
    <div class="modal-header">
      <div id="modal-title" class="modal-title">Item Name</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div id="modal-body" class="modal-body">Description text...</div>
    <div id="modal-detail"></div>
  </div>
</div>

<script type="module">
  import { NavigationMenu } from './menu.js';

  // Default initial evidence bank (fallback)
  const defaultEvidence = [
    {
      id: 'hoofprints',
      name: 'Fresh Hoofprints',
      icon: '🐾',
      desc: 'Single-animal tracks toward the village gate.',
      fake: false,
      category: 'event',
      timelineOrder: 1,
      clues: {
        compare: "Connects directly with Villager's Testimony to confirm only one animal was present at the gate.",
        link: "This represents physical evidence left on the ground, fitting the Event Trail category.",
        timeline: "CHRONOLOGY: These tracks were made 1st, before any disciples arrived or touched the colt.",
        contradict: "RELIABILITY: Physical track impression matches normal, undisturbed walking tracks."
      }
    },
    {
      id: 'testimony',
      name: 'Villager\'s Testimony',
      icon: '🗣️',
      desc: 'The colt was already tied at the village gate.',
      fake: false,
      category: 'people',
      timelineOrder: 2,
      clues: {
        compare: "Pairs with Fresh Hoofprints to prove the disciples untied a specific waiting animal.",
        link: "This is an eyewitness statement given by Tobias, placing it under People & Suspects.",
        timeline: "CHRONOLOGY: Tobias saw the disciples untying the colt (2nd), right after tracks were made but before cloaks were laid.",
        contradict: "RELIABILITY: A credible, calm account from a local resident confirming permission was granted."
      }
    },
    {
      id: 'cloaks',
      name: 'Two Disciples\' Cloaks',
      icon: '🧥',
      desc: 'Cloaks laid down for the colt ride.',
      fake: false,
      category: 'people',
      timelineOrder: 3,
      clues: {
        compare: "Pairs with Zechariah 9:9 Scroll Fragment as physical fulfillment of royal prophecy.",
        link: "These personal garments belong to the disciples, fitting People & Suspects.",
        timeline: "CHRONOLOGY: Placed on the colt (3rd) after untying it, but before palm fronds were scattered on the path.",
        contradict: "RELIABILITY: Authentic garments willingly offered by disciples without struggle."
      }
    },
    {
      id: 'palms',
      name: 'Fresh-Cut Palm Branch',
      icon: '🌿',
      desc: 'Palm fronds scattered along the route.',
      fake: false,
      category: 'prophecy',
      timelineOrder: 4,
      clues: {
        compare: "Does not form a direct 2-item compare pair, but represents the crowd's messianic greeting.",
        link: "A symbolic frond used in royal celebration, belonging in Prophecy & Scripture.",
        timeline: "CHRONOLOGY: Cut and waved (4th) during the processional entry into Jerusalem.",
        contradict: "RELIABILITY: Genuine palm frond matching all reliable eyewitness descriptions of the procession."
      }
    },
    {
      id: 'zechariah',
      name: 'Zechariah 9:9 Scroll Fragment',
      icon: '📜',
      desc: 'Passage about a king entering on a colt.',
      fake: false,
      category: 'prophecy',
      timelineOrder: 5,
      clues: {
        compare: "Pairs with Two Disciples' Cloaks to confirm the prophecy of a humble king riding a colt.",
        link: "An ancient sacred text containing messianic scripture, fitting Prophecy & Scripture.",
        timeline: "CHRONOLOGY: Represents the overall prophetic summary validating the completed entry (5th).",
        contradict: "RELIABILITY: Authentic ancient scroll fragment showing no signs of forgery or tampering."
      }
    },
    {
      id: 'rope',
      name: 'Cut Rope at Tethering Post',
      icon: '🪢',
      desc: 'Rope cut, not untied.',
      fake: true,
      category: 'people',
      timelineOrder: null,
      clues: {
        compare: "Does not link legitimately to any evidence; claims of forced cutting are untruthful.",
        link: "Categorized under People & Suspects due to claims about tethering, but its premise is false.",
        timeline: "N/A — This item describes a theft that never occurred.",
        contradict: "CONTRADICTION: Claims the rope was severed with a blade during a theft, directly contradicting testimony that the colt was untied with permission."
      }
    },
    {
      id: 'complaint',
      name: 'Pharisee\'s Written Complaint',
      icon: '📝',
      desc: 'A complaint about the noisy procession.',
      fake: true,
      category: 'event',
      timelineOrder: null,
      clues: {
        compare: "Does not pair validly with real evidence; exaggerates the peaceful event into a riot.",
        link: "Categorized under Event Trail as a written report, though its claims are false.",
        timeline: "N/A — Describes a violent riot that never actually happened.",
        contradict: "CONTRADICTION: Claims an armed mob stole the colt and staged a violent riot, contradicting peaceful eyewitness reports."
      }
    }
  ];

  // Active Workspace State
  let evidence = [...defaultEvidence];
  let currentTab = 'compare';
  let compareSelected = [];
  let contradictSelected = [];
  let usedEvidence = new Set();
  let linkAssignments = {};
  let timelineItems = [];

  // Function to load selected case into the lab workspace
  function loadCaseIntoLab(caseObj) {
    document.getElementById('active-case-title').textContent = caseObj.title;
    document.getElementById('active-case-subtitle').textContent = caseObj.subtitle || 'Investigate and analyze evidence files for this case.';

    // Populate evidence array from case object if present, else fallback
    if (caseObj.evidence && Array.isArray(caseObj.evidence) && caseObj.evidence.length > 0) {
      evidence = caseObj.evidence;
    } else if (caseObj.evidencePool && Array.isArray(caseObj.evidencePool) && caseObj.evidencePool.length > 0) {
      evidence = caseObj.evidencePool;
    } else if (caseObj.clues && Array.isArray(caseObj.clues) && caseObj.clues.length > 0) {
      evidence = caseObj.clues;
    } else {
      evidence = [...defaultEvidence];
    }

    // Reset workspace state
    compareSelected = [];
    contradictSelected = [];
    usedEvidence = new Set();
    linkAssignments = {};
    evidence.forEach(e => { linkAssignments[e.id] = e.category || 'people'; });
    timelineItems = evidence.filter(e => !e.fake);

    setFeedback(`Loaded "${caseObj.title}". Begin investigating!`, "success");
    renderAll();
  }

  // Initialize Menu and default state
  document.addEventListener('DOMContentLoaded', () => {
    const menu = new NavigationMenu('menu-container', (selectedCase) => {
      loadCaseIntoLab(selectedCase);
    });
    menu.render();

    // Initial setup
    evidence.forEach(e => { linkAssignments[e.id] = 'people'; });
    timelineItems = evidence.filter(e => !e.fake);
    renderAll();
  });

  // UI Helper Functions
  function setFeedback(msg, type = "") {
    const fb = document.getElementById('feedback');
    fb.textContent = msg;
    fb.className = "feedback-box " + type;
  }

  function renderAll() {
    renderCompare();
    renderLink();
    renderTimeline();
    renderContradict();
  }

  /* --- TAB SWITCHING --- */
  window.switchTab = function(tab) {
    currentTab = tab;
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));

    event.target.classList.add('active');
    document.getElementById(`panel-${tab}`).classList.add('active');

    setFeedback(`Active Mode: ${tab.toUpperCase()}. Tap ⓘ buttons for ${tab}-specific clues.`);
    renderAll();
  };

  /* --- COMPARE ACTION --- */
  function renderCompare() {
    const bank = document.getElementById('compare-bank');
    bank.innerHTML = '';
    evidence.forEach(ev => {
      const card = document.createElement('div');
      card.className = 'ev-card' + (usedEvidence.has(ev.id) ? ' used' : '');
      
      const isA = compareSelected[0] === ev.id;
      const isB = compareSelected[1] === ev.id;
      if (isA || isB) card.classList.add('selected');

      let tag = isA ? '<div class="compare-ab">A</div>' : isB ? '<div class="compare-ab">B</div>' : '';

      card.innerHTML = `
        <div class="ev-card-top">
          <div class="ev-card-title-group">
            ${tag}
            <span class="ev-icon">${ev.icon || '🔍'}</span>
            <span class="ev-name">${ev.name || ev.title || 'Evidence'}</span>
          </div>
          <button class="ev-info-btn" onclick="openDetail(event, '${ev.id}')">ⓘ Info</button>
        </div>
        <div class="ev-desc">${ev.desc || ev.description || ''}</div>
      `;

      card.onclick = () => toggleCompare(ev.id);
      bank.appendChild(card);
    });
  }

  function toggleCompare(id) {
    if (usedEvidence.has(id)) return;
    if (compareSelected.includes(id)) {
      compareSelected = compareSelected.filter(i => i !== id);
    } else {
      if (compareSelected.length >= 2) compareSelected.shift();
      compareSelected.push(id);
    }
    renderCompare();
  }

  window.submitCompare = function() {
    if (compareSelected.length < 2) {
      setFeedback("Please select 2 evidence items to compare.", "error");
      return;
    }
    const pair = compareSelected.sort().join('+');
    const validPairs = ['cloaks+zechariah', 'hoofprints+testimony'];

    if (validPairs.includes(pair) || compareSelected.length === 2) {
      setFeedback("Compared correctly! Deduction connection unlocked.", "success");
      compareSelected.forEach(id => usedEvidence.add(id));
      compareSelected = [];
      renderAll();
    } else {
      setFeedback("Not a recognized comparison. Tap ⓘ on items for compare clues.", "error");
    }
  };

  /* --- LINK ACTION --- */
  function renderLink() {
    const container = document.getElementById('link-container');
    container.innerHTML = '';

    evidence.forEach(ev => {
      const row = document.createElement('div');
      row.className = 'link-item-row';
      row.innerHTML = `
        <div class="ev-card-title-group">
          <span class="ev-icon">${ev.icon || '🔍'}</span>
          <span class="ev-name">${ev.name || ev.title}</span>
          <button class="ev-info-btn" onclick="openDetail(event, '${ev.id}')">ⓘ Info</button>
        </div>
        <select class="link-select" onchange="window.updateLinkAssignment('${ev.id}', this.value)">
          <option value="people" ${linkAssignments[ev.id] === 'people' ? 'selected' : ''}>👥 People & Suspects</option>
          <option value="prophecy" ${linkAssignments[ev.id] === 'prophecy' ? 'selected' : ''}>📜 Prophecy & Scripture</option>
          <option value="event" ${linkAssignments[ev.id] === 'event' ? 'selected' : ''}>🐾 Event Trail</option>
        </select>
      `;
      container.appendChild(row);
    });
  }

  window.updateLinkAssignment = function(id, value) {
    linkAssignments[id] = value;
  };

  window.submitLink = function() {
    let correct = true;
    evidence.forEach(ev => {
      if (linkAssignments[ev.id] !== (ev.category || 'people')) correct = false;
    });

    if (correct) {
      setFeedback("Linked correctly! All evidence categorized accurately. (+5 Deduction)", "success");
    } else {
      setFeedback("Incorrect categorizations detected. Check item ⓘ details for category guidance.", "error");
    }
  };

  /* --- TIMELINE ACTION --- */
  function renderTimeline() {
    const list = document.getElementById('timeline-list');
    list.innerHTML = '';

    timelineItems.forEach((ev, index) => {
      const row = document.createElement('div');
      row.className = 'timeline-row';
      row.innerHTML = `
        <div class="ev-card-title-group">
          <strong style="color: #fbbf24;">#${index + 1}</strong>
          <span class="ev-icon">${ev.icon || '🔍'}</span>
          <span class="ev-name">${ev.name || ev.title}</span>
          <button class="ev-info-btn" onclick="openDetail(event, '${ev.id}')">ⓘ Info</button>
        </div>
        <div class="timeline-controls">
          <button class="btn-arrow" onclick="moveTimeline(${index}, -1)">▲</button>
          <button class="btn-arrow" onclick="moveTimeline(${index}, 1)">▼</button>
        </div>
      `;
      list.appendChild(row);
    });
  }

  window.moveTimeline = function(index, dir) {
    const target = index + dir;
    if (target < 0 || target >= timelineItems.length) return;
    const temp = timelineItems[index];
    timelineItems[index] = timelineItems[target];
    timelineItems[target] = temp;
    renderTimeline();
  };

  window.submitTimeline = function() {
    let isCorrect = true;
    for (let i = 0; i < timelineItems.length - 1; i++) {
      if ((timelineItems[i].timelineOrder || i) > (timelineItems[i + 1].timelineOrder || i + 1)) {
        isCorrect = false;
        break;
      }
    }

    if (isCorrect) {
      setFeedback("Timeline correct! Chronological order established. (+10 Deduction)", "success");
    } else {
      setFeedback("Wrong timeline order. Tap ⓘ to read event sequence indicators.", "error");
    }
  };

  /* --- CONTRADICT ACTION --- */
  function renderContradict() {
    const bank = document.getElementById('contradict-bank');
    bank.innerHTML = '';

    evidence.forEach(ev => {
      const card = document.createElement('div');
      card.className = 'ev-card' + (contradictSelected.includes(ev.id) ? ' selected' : '');

      card.innerHTML = `
        <div class="ev-card-top">
          <div class="ev-card-title-group">
            <span class="ev-icon">${ev.icon || '🔍'}</span>
            <span class="ev-name">${ev.name || ev.title}</span>
          </div>
          <button class="ev-info-btn" onclick="openDetail(event, '${ev.id}')">ⓘ Info</button>
        </div>
        <div class="ev-desc">${ev.desc || ev.description || ''}</div>
      `;

      card.onclick = () => toggleContradict(ev.id);
      bank.appendChild(card);
    });
  }

  function toggleContradict(id) {
    if (contradictSelected.includes(id)) {
      contradictSelected = contradictSelected.filter(i => i !== id);
    } else {
      contradictSelected.push(id);
    }
    renderContradict();
  }

  window.submitContradict = function() {
    const fakes = evidence.filter(e => e.fake).map(e => e.id).sort().join(',');
    const selected = [...contradictSelected].sort().join(',');

    if (fakes === selected) {
      setFeedback("All fake/contradictory items identified successfully! (+15 Challenge)", "success");
    } else {
      setFeedback("Incorrect selection. Check details (ⓘ) for items with reliability warnings.", "error");
    }
  };

  /* --- MODAL DIALOG --- */
  window.openDetail = function(event, evId) {
    event.stopPropagation();
    const item = evidence.find(e => e.id === evId);
    if (!item) return;

    const cluesObj = item.clues || {};
    const activeClue = cluesObj[currentTab] || item.hint || "No specific hint available for this section.";

    document.getElementById('modal-title').textContent = `${item.icon || '🔍'} ${item.name || item.title}`;
    document.getElementById('modal-body').textContent = item.desc || item.description || '';
    document.getElementById('modal-detail').innerHTML = `
      <div class="detail-row">
        <strong>${currentTab.toUpperCase()} HINT:</strong>
        <span>${activeClue}</span>
      </div>
    `;

    document.getElementById('modal-mask').style.display = 'flex';
  };

  window.closeModal = function() {
    document.getElementById('modal-mask').style.display = 'none';
  };
</script>

