      "start": [
        [
          "^I am Master Scribe. The archives hold testimony — not opinion.",
          "\n",
          "^Many have walked these stones carrying questions no scroll could answer.",
          "\n",
          "ev",
          "str",
          "^I seek truth here.",
          "/str",
          "/ev",
          {
            "*": ".^.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^What do the streets say?",
          "/str",
          "/ev",
          {
